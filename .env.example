# ── Core application ────────────────────────────────────────────
APP_NAME=Findora Spaces
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-value-in-production
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Data stores ─────────────────────────────────────────────────
# Host ports are 5455 (Postgres) and 6380 (Redis) to avoid clashing with local services.
DATABASE_URL=postgresql+psycopg://findora:findora_dev_password@localhost:5455/findora
REDIS_URL=redis://localhost:6380/0

# ── Sessions & security ─────────────────────────────────────────
SESSION_COOKIE_NAME=findora_session
CSRF_COOKIE_NAME=findora_csrf
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
OTP_DEBUG=true

# ── Media ───────────────────────────────────────────────────────
UPLOAD_DIR=uploads
PUBLIC_MEDIA_BASE=/media
MAX_UPLOAD_MB=25
# S3-compatible storage (leave blank for local filesystem in development)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# ── Maps ────────────────────────────────────────────────────────
MAP_TILE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_TILE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
GEOCODING_PROVIDER_URL=https://nominatim.openstreetmap.org

# ── M-Pesa / Daraja ─────────────────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:8000/api/v1/payments/callback
MPESA_CALLBACK_SECRET=dev-callback-secret
MPESA_MOCK=true

# ── Notifications ───────────────────────────────────────────────
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=FINDORA
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=hello@findora.co.ke
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Freshness & policy ──────────────────────────────────────────
DEFAULT_FRESHNESS_DAYS=14
AVAILABILITY_REMINDER_DAYS=3
